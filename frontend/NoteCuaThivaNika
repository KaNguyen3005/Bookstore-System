Home.tsx
   ↓
bookService.ts
   ↓
mockBooks (data giả)


import { useEffect, useState } from "react";
import { getBooks } from "../services/bookService";

import { useEffect, useState } from "react"
import { getBooks } from "../services/bookService"
import { Book } from "../types/Book"


function Home() {

  const [books, setBooks] = useState<Book[]>([])

  useEffect(() => {
    getBooks().then((data) => {
      setBooks(data)
    })
  }, [])

  return (
    <div>
      <h2>Book List</h2>

      {books.map(book => (
        <div key={book.id}>
          <p>{book.title}</p>
          <p>{book.price}</p>
        </div>
      ))}
    </div>
  )
}

export default Home



